# Game settings for the shared Makefile (from geyser-love2d-template). This
# file belongs to the game: copier never overwrites it.
GAME := {{ game }}
TITLE := {{ title }}
AUTHOR := {{ author }}
DESCRIPTION := {{ description }}
WIDTH := {{ width }}
HEIGHT := {{ height }}

# Extra files or folders to package into dist/$(GAME).love:
# LOVE_EXTRA := data

# Extra checks for `make test`:
# TEST_EXTRA :=

# Cover image used by `make cart` (defaults to docs/screenshots/cart.png):
# CART_COVER := docs/screenshots/cart.png
